# Clerk authentication (get from https://dashboard.clerk.com/)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase project URL (get from https://supabase.com/dashboard/)
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Supabase Edge Functions anonymous key (safe to expose, only for calling functions)
VITE_SUPABASE_ANON_KEY=eyJ...

# Stripe publishable key (for checkout, optional in phase 1)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Server-side only (used by Supabase Edge Functions, not the browser) ---
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# CLERK_SECRET_KEY=sk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
